# Shared by both systemd services. Protect the installed file with mode 0600.
CAMELLIA_REMOTE_KEY=_
CAMELLIA_REMOTE_IDENTITY_PORT=21116
CAMELLIA_REMOTE_RELAY_PORT=21117
CAMELLIA_REMOTE_RELAY_SERVERS=remote.example.com:21117
CAMELLIA_REMOTE_API_SERVER=https://api.example.com
CAMELLIA_REMOTE_TRUST_PROXY_HEADERS=N

# Required when the management API verifies device-originated requests.
CAMELLIA_REMOTE_DEVICE_VERIFICATION_TOKEN_FILE=/etc/camellia-remote/device-verification-token

# Optional structured logging filter.
CAMELLIA_REMOTE_LOG_FILTER=info
