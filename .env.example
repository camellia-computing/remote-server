# Optional runtime configuration read from the server working directory.
# Keep secrets in a separate root-owned file and reference that file here.
CAMELLIA_REMOTE_API_SERVER=https://api.example.com
CAMELLIA_REMOTE_DEVICE_VERIFICATION_TOKEN_FILE=/run/secrets/device_verification_token
CAMELLIA_REMOTE_RELAY_SERVERS=remote.example.com:21117
CAMELLIA_REMOTE_IDENTITY_PORT=21116
CAMELLIA_REMOTE_RELAY_PORT=21117
CAMELLIA_REMOTE_TRUST_PROXY_HEADERS=N
